// Publicación en Cloudflare (Workers con archivos estáticos). Cloudflare corre
// `npm run build` y luego `npx wrangler deploy`, que sube la carpeta dist/.
// El nombre debe coincidir con el del proyecto en el panel de Cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "academia-creativa-finanzas",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // App de una sola página: cualquier ruta abre index.html.
    "not_found_handling": "single-page-application",
  },
}
