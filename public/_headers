# Encabezados para Cloudflare Pages (y Netlify, mismo formato).
# v1: link privado, que los buscadores no indexen nada (SPEC 10 y 12).
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# El service worker y la página se revisan siempre: así llegan las actualizaciones.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Archivos con huella en el nombre: no cambian nunca.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
